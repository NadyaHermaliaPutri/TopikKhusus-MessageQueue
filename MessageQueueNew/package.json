{
  "name": "messagequeue-new-node",
  "version": "1.0.0",
  "description": "Node.js RabbitMQ publisher-consumer reimplementation",
  "private": true,
  "scripts": {
    "start:publisher": "node publisher/index.js",
    "start:consumer:email": "set \"CONSUMER_TYPE=email\" && node consumer/index.js",
    "start:consumer:sms": "set \"CONSUMER_TYPE=sms\" && node consumer/index.js",
    "start:consumer:fcm": "set \"CONSUMER_TYPE=fcm\" && node consumer/index.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "amqplib": "^0.10.5",
    "dotenv": "^16.4.3",
    "express": "^4.18.2",
    "pino": "^8.21.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
